# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log
dev-server-err.log

# supabase log exports
supabase_logs*.json

# env files (can opt-in for committing if needed)
.env*

# local backups (db dumps + storage snapshots) — never committed
/backups/
/backups.zip
.backup.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
